---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Menu from '../components/Menu.astro';
import site from '../data/site.json';
import { publishedPages } from '../lib/navigation.js';

const pages = publishedPages(await getCollection('pages'));
const page = pages.find((page) => page.id === 'ru');
---

<Base title={`${site.name} — портфолио`} pageId="ru">
  <Menu page={page} pages={pages} />
</Base>
